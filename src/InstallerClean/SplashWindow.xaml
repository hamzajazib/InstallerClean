<Window x:Class="InstallerClean.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InstallerClean.Resources"
        xmlns:chrome="clr-namespace:InstallerClean.Controls"
        xmlns:a11y="clr-namespace:InstallerClean.Helpers"
        Title="{loc:Translate Window.Main.Title}"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{StaticResource Surface.Sidebar}" CornerRadius="{StaticResource Radius.CardSm}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- top spacer -->
                <RowDefinition Height="Auto"/>  <!-- icon -->
                <RowDefinition Height="16"/>    <!-- gap -->
                <RowDefinition Height="Auto"/>  <!-- app name -->
                <RowDefinition Height="28"/>    <!-- gap -->
                <RowDefinition Height="Auto"/>  <!-- progress bar -->
                <RowDefinition Height="8"/>     <!-- gap -->
                <RowDefinition Height="Auto"/>  <!-- step text -->
                <RowDefinition Height="Auto"/>  <!-- stop-waiting button -->
                <RowDefinition Height="Auto"/>  <!-- what it leaves alone -->
                <!-- 4, off the 8/12/16/24 scale: ties the ticker to the
                     step line as one block, the way the operating
                     overlay pairs its count and filename lines. -->
                <RowDefinition Height="4"/>     <!-- gap -->
                <RowDefinition Height="Auto"/>  <!-- ticker -->
                <RowDefinition Height="12"/>    <!-- gap -->
                <RowDefinition Height="Auto"/>  <!-- cancel button -->
                <RowDefinition Height="*"/>     <!-- bottom spacer -->
            </Grid.RowDefinitions>

            <!-- Icon (centred hero) -->
            <chrome:DecorativeImage Grid.Row="1" Source="Assets/splash-icon.png"
                   Width="96" Height="96"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- App name -->
            <TextBlock Grid.Row="3" Text="{loc:Translate Window.Main.Title}"
                       Foreground="{StaticResource Text.Heading}"
                       FontSize="{DynamicResource Type.Display}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <!-- Progress bar. Splash is the brand moment, not functional UI:
                 a heavier 12px bar reads as deliberate against the 96px hero
                 icon and 28pt headline, where the 8px scan-overlay bar would
                 look anaemic. -->
            <ProgressBar Grid.Row="5" x:Name="SplashProgress"
                         Minimum="0" Maximum="100" Value="0"
                         Height="12" Margin="48,0"
                         AutomationProperties.Name="{loc:Translate Automation.StartupScanProgress}"/>
            <!-- Step text. LiveSetting=Polite announces the splash's
                 step transitions to Narrator: without it, the
                 cancellation message and the per-step "Asking Windows
                 about installed software..." progress go unread.

                 It wraps, centred, inside the card: a wait can name a
                 share too long for one line. The margin keeps a wrapped
                 line off the card's edges. Code-behind sets the text and
                 the name a screen reader speaks, together. -->
            <TextBlock Grid.Row="7"
                       x:Name="StepText"
                       Foreground="{StaticResource Text.Body}"
                       FontSize="{DynamicResource Type.Body}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="16,0"
                       AutomationProperties.LiveSetting="Polite"/>

            <!-- Shown only while the step text names a wait, and gone with the
                 next line written there (code-behind). It gives up on that
                 drive or share and the scan carries on. It sits 4 under the
                 step text, as on the two cards in the main window, and never
                 takes the focus itself. Its spoken name, naming the drive or
                 share, is set from code-behind with the wait. -->
            <Button Grid.Row="8"
                    x:Name="StopWaitingButton"
                    Content="{loc:Translate Action.StopWaiting}"
                    Click="StopWaitingClick"
                    Style="{StaticResource SmallGhostPill}"
                    Padding="16,0"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    AutomationProperties.HelpText="{loc:Translate Status.StopWaitingLeavesAlone}"/>

            <!-- What the button leaves alone, shown with it, in the ticker's
                 colour and size. It wraps inside the card as the step text
                 does. No LiveSetting: the step text's spoken name carries the
                 same sentence while the button shows. -->
            <TextBlock Grid.Row="9"
                       x:Name="StopWaitingLeavesAlone"
                       Text="{loc:Translate Status.StopWaitingLeavesAlone}"
                       Foreground="{StaticResource Text.Dim}"
                       FontSize="{DynamicResource Type.Caption}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="16,2,16,0"
                       Visibility="Collapsed"/>

            <!-- Ticker: a count of the folder's files as the scan lists
                 them, the name of each installed program as it asks
                 Windows about it, then a count of the files as it matches
                 them. Display-only; no LiveSetting, because it updates once
                 per program and many times while the files are counted, and
                 a live region would queue one announcement per update. The
                 step text above stays the announced line. -->
            <TextBlock Grid.Row="11"
                       x:Name="ProductTicker"
                       Foreground="{StaticResource Text.Dim}"
                       FontSize="{DynamicResource Type.Caption}"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="{a11y:TextScaled 360}"/>

            <!-- Cancel button -->
            <Button Grid.Row="13"
                    x:Name="CancelButton"
                    Content="{loc:Translate Action.Cancel}"
                    Click="CancelClick"
                    IsCancel="True"
                    Style="{StaticResource SmallGhostPill}"
                    Padding="16,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="{loc:Translate Automation.CancelStartupScan}"/>

            <!-- Version (bottom right, overlaid) -->
            <TextBlock Grid.Row="14"
                       x:Name="VersionText"
                       Foreground="{StaticResource Text.Dim}"
                       FontSize="{DynamicResource Type.Caption}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,16,12"/>
        </Grid>
    </Border>
</Window>
